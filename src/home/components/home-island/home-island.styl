@require 'mixins.styl'

.wt-home-island
  display flex
  position sticky
  top 20px
  align-items center
  justify-content space-between
  margin 0 auto
  padding 0 20px
  width 100%
  max-width 320px
  height 60px
  background-color rgba(255, 255, 255, 0.45)
  border-radius 30px
  box-sizing border-box
  z-index var(--wt-layer-highest)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  .wt-logo
    &.has-wordmark
      width 100px
      height 20px
  .wt-button
    justify-content center
    padding 0
    width 100px
    border-radius 14px
