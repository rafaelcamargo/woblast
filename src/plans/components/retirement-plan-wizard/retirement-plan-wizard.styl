.wt-retirement-plan-wizard
  display flex
  flex-direction column
  gap 24px
  width 100%
  label
    display flex
    align-items flex-start
    gap 16px
    cursor pointer
    h3
      font-size var(--wt-font-size-sm)
      font-weight 700
    p
      font-size var(--wt-font-size-xs)
    input[type=radio]
      flex-shrink 0
      margin 2px 0 0
      width 22px
      height 22px
      background-color var(--wt-color-lightest)
      border-width 1px
      border-style solid
      border-color var(--wt-color-primary)
      border-radius 22px
      box-sizing border-box
      box-shadow 0 0 0 var(--wt-color-blue-lighter)
      appearance none
      outline 0
      transition-property box-shadow, border-color
      transition-duration 200ms
      transition-timing-function ease-in-out
      &:focus,
      &:active
        box-shadow 0 0 0 4px var(--wt-color-blue-lighter)
        border-color var(--wt-color-blue-mid-dark)
      &:checked
        background-color var(--wt-color-primary)
        background-image url('data:image/svg+xml;base64,')
        background-size 12px 12px
        background-position center center
        background-repeat no-repeat
        border-color var(--wt-color-primary)
      &:disabled
        background-color var(--wt-color-gray-light)
    input[type=text]
      width 100%
      margin-top 8px
      padding 12px 16px
      border 0
      border-radius 12px
      background-color var(--wt-color-gray-mid-lighter)
      color var(--wt-color-darkest)
      font-family var(--wt-font-family-primary)
      font-size var(--wt-font-size-sm)
      box-sizing border-box

.wt-retirement-plan-wizard-option-copy
  display flex
  flex-direction column
  flex 1
  gap 8px
