.wt-number-input
  position relative
  display block
  width 100%

  &.is-currency,
  &.is-percent
    input
      padding-left 40px

  &.is-currency::before,
  &.is-percent::before
    display flex
    align-items center
    justify-content center
    position absolute
    left 0
    bottom 0
    // transform translateY(-50%)
    width 40px
    height 40px
    // text-align center
    color var(--wt-color-gray)
    pointer-events none

  &.is-currency::before
    content '$'

  &.is-percent::before
    content '%'
