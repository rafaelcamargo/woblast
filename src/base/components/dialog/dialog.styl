.wt-dialog-overlay
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  background-color rgba(61, 63, 67, .7)
  backdrop-filter blur(2px)
  -webkit-backdrop-filter blur(2px)
  opacity 0
  pointer-events none
  transition opacity 200ms ease-out
  z-index var(--wt-layer-middle)
  &.is-open
    opacity 1
    pointer-events auto

.wt-dialog-wrapper
  display flex
  position fixed
  top 0
  right 0
  bottom 0
  left 0
  align-items center
  justify-content center
  padding 0 20px
  opacity 0
  pointer-events none
  transition opacity 200ms ease-out
  z-index var(--wt-layer-high)
  &.is-open
    opacity 1
    pointer-events auto
  dialog
    position relative
    margin 0
    padding 20px
    width 100%
    max-width 420px
    border 1px solid var(--wt-color-gray-light)
    border-radius 24px
    background-color var(--wt-color-lightest)
    header
      display flex
      justify-content space-between
      align-items center
      margin-bottom 24px
      h2
        font-size var(--wt-font-size-lg)
        font-weight 700
