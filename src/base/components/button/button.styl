@require 'mixins.styl'

.wt-button
  form-control()
  display inline-flex
  align-items center
  padding 0 32px
  height 40px
  background-color var(--wt-color-gray-light)
  color var(--wt-color-gray-dark)
  font-family var(--wt-font-family-primary)
  font-size var(--wt-font-size-sm)
  font-weight 700
  text-decoration none
  border-radius 12px
  cursor pointer
  &.is-primary
    background-color var(--wt-color-primary)
    color var(--wt-color-lightest)
    --wt-color-icon var(--wt-color-lightest)
  &.is-secondary
    background-color var(--wt-color-blue-mid-lighter)
    color var(--wt-color-blue-mid-dark)
    --wt-color-icon var(--wt-color-blue-mid-dark)
  &.is-small
    width 28px
    height 28px
    padding 0
    font-size var(--wt-font-size-xs)
    border-radius 6px
    .wt-icon
      width 28px
      height 28px
  &:focus:not(:disabled)
    form-control-focus()
  &:disabled,
  &[aria-disabled="true"]
    background-color var(--wt-color-gray-light)
    color var(--wt-color-gray)
    cursor default
    pointer-events none
    --wt-color-icon var(--wt-color-gray)
